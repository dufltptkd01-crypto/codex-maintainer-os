{
  "name": "codex-maintainer-os",
  "version": "0.1.0",
  "description": "An open-source maintainer operating layer that turns GitHub issues and PRs into a Codex-ready work queue.",
  "type": "module",
  "bin": {
    "cmo": "./src/cli.ts"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ky": "^1.14.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "bun-types": "^1.3.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
